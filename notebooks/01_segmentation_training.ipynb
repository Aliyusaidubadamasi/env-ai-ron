   "source": [
    "# 01 - Segmentation Training\n",
    "\n",
    "This notebook provides a training skeleton for a 3-class urban land cover segmentation model.\n",
    "\n",
    "Classes:\n",
    "- concrete\n",
    "- existing_canopy\n",
    "- bare_soil\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "import torch\n",
    "import segmentation_models_pytorch as smp\n",
    "\n",
    "DATA_DIR = Path(\"../data/\")\n",
    "MODEL_PATH = Path(\"../models/urban_segmentation_model.pt\")\n",
    "\n",
    "print(\"Environment ready\")\n",
    "print(\"Dataset directory exists:", DATA_DIR.exists(), \")\n",
    "\n",
    "# Example model setup\n",
    "model = smp.Unet(\n",
    "    encoder_name=\"resnet34\",\n",
    "    encoder_weights=\"imagenet\",\n",
    "    in_channels=3,\n",
    "    classes=3,\n",
    ")\n",
    "\n",
    "optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)\n",
    "print(model)\n",
    "print(optimizer)\n"
   ]
  }
